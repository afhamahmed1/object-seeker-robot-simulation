<?xml version="1.0"?>
<package format="3">
  <name>seeker_yolo</name>
  <version>0.1.0</version>
  <description>YOLO object detector for the Seeker robot camera.</description>
  <maintainer email="afham12ahmed@gmail.com">Afham Ahmed</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <!-- ultralytics (YOLO) is installed with pip in ~/yolo_venv, see README -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
